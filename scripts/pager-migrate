#!/bin/bash
# Move windows off workspaces above the configured count, then restore the
# view. Used when the pager's workspace count is lowered.
# Usage: pager-migrate <count>
#
# Omarchy's Hyprland lua bridge wraps every dispatch string, so window moves
# go through hl.dsp: focus the window, move the now-active window with
# follow = false, and put the view back at the end.

set -u

count=${1:?usage: pager-migrate <count>}
case $count in
  ''|*[!0-9]*) exit 1 ;;
esac
(( count < 1 )) && exit 1

prev_active=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id')
case $prev_active in
  ''|*[!0-9]*) prev_active= ;;
esac

# Windows above the count in each 10-workspace monitor band go to that
# band's last remaining slot (11..20, 21..30, ...).
clients=$(hyprctl clients -j 2>/dev/null | jq -r --argjson n "$count" '
  .[] | select((.workspace.id | type) == "number" and .workspace.id > 0) |
  (.workspace.id - 1) as $z |
  (($z / 10 | floor) * 10) as $base |
  (($z % 10) + 1) as $slot |
  select($slot > $n) |
  "\(.address) \($base + $n)"' 2>/dev/null) || clients=

while read -r addr target; do
  [ -n "$addr" ] || continue
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.window.move({ workspace = $target, follow = false })" >/dev/null 2>&1
done <<< "$clients"

# Put the view back on the pre-migration workspace when it still exists;
# otherwise focus the last remaining slot in the same monitor band.
if [[ $prev_active =~ ^[0-9]+$ ]]; then
  slot=$(( (prev_active - 1) % 10 + 1 ))
  base=$(( prev_active - slot ))
  if (( slot > count )); then target=$(( base + count )); else target=$prev_active; fi
else
  target=$count
fi
(( target < 1 )) && target=$count
hyprctl dispatch "hl.dsp.focus({ workspace = $target })" >/dev/null 2>&1

exit 0
